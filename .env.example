# Базовые переменные окружения
ENV=dev
HTTP_ADDR=:2010

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_IDS=12345,67890

# STT: omni (Selectel Chat Completions) или classic (audio/transcriptions)
STT_MODE=omni
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.selectel.ru/aig/v1
OPENAI_STT_MODEL=qwen/qwen3.8-omni-flash

# Логирование
LOG_CONSOLE_LEVEL=info
LOG_FILE_LEVEL=debug
LOG_FILE=
